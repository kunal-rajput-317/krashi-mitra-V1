{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)"
    ]
  }
}
