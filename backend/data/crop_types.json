  "rules": [
    { "match": ["-dal", "dal-", "chennangi"], "type": "staple", "why": "Milled pulses are dry, graded and warehouse-traded." },
    { "match": ["whole", "-gram", "gram-", "lentil", "masur", "kulthi", "mataki", "cowpea-lobia", "field-pea", "peas-dry", "white-peas", "alasande", "lak-teora", "other-pulses"], "type": "staple", "why": "Whole pulses keep for months and sell against MSP and market cycles, not daily." },
    { "match": ["millet", "-oil"], "type": "staple", "why": "Millets and oils move on season cycles." },
    { "match": ["leaves", "leaf", "saag", "flower", "loose", "rose", "jasmine", "marigold", "chrysanthemum", "carnation", "tube-", "lilly", "lotus", "-gourd", "gourd-", "kai", "-veg", "fresh"], "type": "perishable", "why": "Leafy greens, cut flowers and gourds are day-traded and unstorable." },
    { "match": ["dry", "dried", "powder", "spice", "cummin", "jeera", "corriander-seed", "methi-seeds", "ajwan", "soanf", "suva", "bay-leaf", "black-pepper", "cardamom", "chicory", "chikory", "kasni", "asalia", "chandrashoor"], "type": "storable", "why": "Dried spices and stored forms hold for a full season in a godown." },
    { "match": ["seed"], "type": "staple", "why": "Seed lots are dry and season-traded. Listed after the spice rule so dried spice seeds classify as storable first." },
    { "match": ["fruit", "berry", "melon"], "type": "perishable", "why": "Fresh fruit defaults to daily unless named as a dry or stored form above." }
  ],

  "_excluded_note": "Livestock, fish and forest produce (goat, cow, pigs, she-buffalo, duck, egg, fish, prawn, wood, firewood, tendu-leaves, neem-seed, dhaincha, laha, gokhru, gulli, broomstick-flower-broom, dry-fodder, flowers-others, sabu-dan, buttery, ghee) are not crops with a sale-cadence decision of this kind. They fall through to the default and keep today's layout. bhav.py's own _NON_CROP set is the separate guard for what should not render as a crop at all."
}
